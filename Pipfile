[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"
# installing pytorch with pipenv is a hastle
# see https://github.com/pypa/pipenv/issues/4961 
# and https://github.com/pytorch/pytorch/blob/main/RELEASE.md#release-compatibility-matrix 

[[source]]
url = "https://download.pytorch.org/whl/cpu/"
verify_ssl = false
name = "pytorch"

[packages]
torch = {version = "*", index = "pytorch"}
wandb = "*"
pandas = "*"
numpy = "*"
scikit-learn = "*"
pytorch-model-summary = "*"
matplotlib = "*"
jupyter = "*"
pyarrow = "*"
plotly = "*"
datapane = "*"
ydata-profiling = "*"
numba = "<=0.58.1"  # numba 0.59.0 caused an import error in ydata-profiling
rich = "*"

[dev-packages]
yapf = "*"
pylint = "*"
ruff = "*"

[requires]
python_version = "3.11.9"
