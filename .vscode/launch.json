    "version": "0.2.0",
    "configurations": [
        {
            "name": "Offline Run",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "epochs=6",
                "skip_log_summary=True",
                // "evaluation.plot_functions=null",
                "evaluation.n_steps=4",
                "evaluation.max_n=5",
                "data.seq_length=64",
                "batch_size=16",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=null"
            ],
            "justMyCode": true
            
        },
        {
            "name": "Run on Wandb",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                // "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "epochs=1",
                "evaluation.n_steps=2",
                "evaluation.plot_functions=null",
                "skip_log_summary=True",
                "batch_size=16",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=null"
            ],
            "justMyCode": true
            
        },
        {
            "name": "Run sweep agent",
            "type": "debugpy",
            "request": "launch",
            "module": "wandb",
            "env": {
                // "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "agent",
        "deep-learning-course-team/plasma/cll26e4t"
            ],
            "justMyCode": false
            
        }
    ]
}