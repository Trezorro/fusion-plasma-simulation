    "version": "0.2.0",
    "configurations": [
        {
            "name": "Offline Run",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "run_name=testrunoffline",
                "epochs=1",
                "skip_log_summary=True",
                // "reeval=True",
                "evaluation.plot_functions=null",
                "evaluation.n_steps=6",
                "evaluation.max_n=4",
                // "data.seq_length=64",
                "limit_val_batches=1",
                "limit_test_batches=2",
                "batch_size=10",
                "data.batch_size=10",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=1",
                // "base_run=doublehistory_seq_normal_smC_BIG2",
                // "test_cache_name=doublehistory_seq_normal_smC_BIG2_cache2",
                // "test_cache_mode=use"
            ],
            "justMyCode": true
            
        },
        {
            "name": "Run on Wandb",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                // "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "epochs=1",
                "run_name=test_wandb_debug",
                "evaluation.n_steps=2",
                "evaluation.plot_functions=null",
                "skip_log_summary=True",
                "batch_size=5",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=null"
            ],
            "justMyCode": true
            
        },
        {
            "name": "Reeval",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "reeval=true",
                "run_name=reeval_test",
                "epochs=1",
                "evaluation.n_steps=2",
                "evaluation.plot_functions=null",
                "skip_log_summary=True",
                "batch_size=16",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=null",
                "data.batch_size=16"
            ],
            "justMyCode": true

        },
        {
            // Quick end-to-end test of the autoregressive rollout pipeline on the paper
            // CFM model (base_run from reeval.yaml, ckpt fetched from wandb). Two test
            // shots, light integration; rollout stage runs after trainer.test and writes
            // {run_name}_rollout.h5 + rollouts.html. Wandb stays ON so the summary and
            // browser land in the run.
            "name": "Reeval Rollout Test",
            "type": "debugpy",
            "request": "launch",
            "module": "run",
            "env": {
                "WANDB_NOTES": "rollout pipeline test",
            },
            "args": [
                "reeval=true",
                "run_name=rollout_pipeline_test",
                "epochs=1",
                "evaluation.n_steps=8",
                "evaluation.plot_functions=null",
                "skip_log_summary=True",
                "batch_size=16",
                "data.batch_size=16",
                "limit_val_batches=1",
                "limit_test_batches=2",
                "model.params.batch_rematch_factor=1",
                "model.params.step_every_nth_match=null",
                "data.test_shots=[73368,64770]",
                "window_set=[[73368,0.38],[64770,1.09]]",
                "rollout.max_batch=8",
            ],
            "justMyCode": true
        },
        {
            "name": "Run sweep agent",
            "type": "debugpy",
            "request": "launch",
            "module": "wandb",
            "env": {
                // "WANDB_MODE":"disabled",
                "WANDB_NOTES": "debugging",
            },
            "args": [
                "agent",
        "deep-learning-course-team/plasma/cll26e4t"
            ],
            "justMyCode": false
            
        }
    ]
}
