{
    "yapf.args": [
        "--style", 
        "{based_on_style: google, indent_width: 4, column_limit: 110, DEDENT_CLOSING_BRACKETS: True}"
    ],
    "editor.rulers": [
        {
            "column": 110,
            "color": "#8e111182"
        }
    ],
"python.analysis.autoImportCompletions": true,
"ruff.lineLength": 110,
"python.testing.pytestArgs": [
    "src"
],
"python.testing.unittestEnabled": false,
"python.testing.pytestEnabled": true

}