{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Local Experiment",
        "type": "shell",
        "command": "git diff-index --quiet HEAD -- && pipenv run python run.py run_name='${input:run_name}' || echo 'Git status is not clean. Commit, then run.'"
      },
      {
        "label": "Run Snellius Experiment",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job_snellius.sh '${input:run_name}'",
        "problemMatcher": []
      },
      {
        "label": "Reeval Snellius Experiment",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job_snellius.sh '${input:run_name}' --reeval",
        "problemMatcher": []
      },
      {
        "label": "Run HPC Experiment",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job_HPC.sh '${input:run_name}'",
        "problemMatcher": [
          "$python"
        ]
      },
      {
        "label": "Submit HPC Sweep Agent",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_HPC_sweep_agent.sh '${input:sweep_id}'",
        "problemMatcher": [
          "$python"
        ]
      },
      {
        "label": "Submit Snellius Sweep Agent",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_snellius_sweep_agent.sh '${input:sweep_id}' '${input:use_cpu}'",
        "problemMatcher": [
          "$python"
        ]
      },
      {
        "label": "Sync snellius",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job_snellius.sh",
        "problemMatcher": []
      },
      {
        "label": "Sync traces",
        "type": "shell",
        "command": "rsync -avzv mtresoor@snellius.surf.nl:/home/mtresoor/fusion-plasma-simulation/output/traces output/snellius/traces",
        "problemMatcher": []
      },
      {
        "label": "Sync pdf plots",
        "type": "shell",
        "command": "rsync -avzv mtresoor@snellius.surf.nl:/home/mtresoor/fusion-plasma-simulation/output/pdfplots/ output/pdfplots/",
        "problemMatcher": []
      }
    ],
  "inputs": [
    {
      "id": "run_name",
      "type": "promptString",
       "description": "What is the experiment run name?",
      // type specific configuration attributes
    },
    {
      "id": "sweep_id",
      "type": "promptString",
       "description": "What is the sweep ID to link the agent to?",
      // type specific configuration attributes
    },
    {
      "id": "use_cpu",
      "type": "pickString",
      "description": "Do you want to use the CPU?",
      "options": [
        "No, GPU!",
        "CPU"
      ],
    }
]
}