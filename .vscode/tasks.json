{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Local Experiment",
        "type": "shell",
        "command": "git diff-index --quiet HEAD -- && pipenv run python run.py run_name='${input:run_name}' || echo 'Git status is not clean. Commit, then run.'"
      },
      {
        "label": "Run Snellius Experiment",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job_snellius.sh '${input:run_name}'"
      },
      {
        "label": "Run HPC Cluster Experiment",
        "type": "shell",
        "command": "bash src/HPC_setup/submit_remote_job.sh '${input:run_name}'",
        "problemMatcher": [
          "$python"
        ]
      },
      {
        "label": "Sync slurms",
        "type": "shell",
        "command": "rsync -avzv mtresoor@snellius.surf.nl:/home/mtresoor/fusion-plasma-simulation/output/slurms output/snellius/ && rsync -avzv TUE_s162507@datamininghpc.win.tue.nl:/home/TUE/s162507/fusion-plasma-simulation/output/slurms output/hpc/"
      },
    ],
  "inputs": [
    {
      "id": "run_name",
      "type": "promptString",
       "description": "What is the experiment run name?",
      // type specific configuration attributes
    }
]
}